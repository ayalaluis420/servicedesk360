<?xml version="1.0" encoding="UTF-8"?>
<faces-config xmlns="http://xmlns.jcp.org/xml/ns/javaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-facesconfig_2_3.xsd"
              version="2.3">

    <!-- Guía 10: mensajes estándar de JSF en español -->
    <application>
        <message-bundle>sv.edu.itca.servicedesk360.mensajes</message-bundle>
        <locale-config>
            <default-locale>es</default-locale>
        </locale-config>
    </application>

    <!-- Parte I: registra las fases del ciclo de vida (si LOG_CICLO_VIDA = true). -->
    <lifecycle>
        <phase-listener>sv.edu.itca.servicedesk360.jsf.CicloVidaListener</phase-listener>
    </lifecycle>

    <!-- Parte J / Ejercicio 4: navegación explícita desde la vista de inicio.
         Las vistas de clientes usan navegación implícita (outcome = nombre de la vista). -->
    <navigation-rule>
        <from-view-id>/app/inicio.xhtml</from-view-id>
        <navigation-case>
            <from-outcome>clientes</from-outcome>
            <to-view-id>/app/clientes/lista.xhtml</to-view-id>
            <redirect />
        </navigation-case>
        <navigation-case>
            <from-outcome>equipos</from-outcome>
            <to-view-id>/app/equipos/lista.xhtml</to-view-id>
            <redirect />
        </navigation-case>
        <navigation-case>
            <from-outcome>tickets</from-outcome>
            <to-view-id>/app/tickets/lista.xhtml</to-view-id>
            <redirect />
        </navigation-case>
    </navigation-rule>

    <!-- Desde cualquier vista JSF, el outcome "inicio" vuelve a la portada. -->
    <navigation-rule>
        <from-view-id>*</from-view-id>
        <navigation-case>
            <from-outcome>inicio</from-outcome>
            <to-view-id>/app/inicio.xhtml</to-view-id>
            <redirect />
        </navigation-case>
    </navigation-rule>
</faces-config>
